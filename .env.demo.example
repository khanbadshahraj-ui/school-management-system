# Copy values into provider secret settings; never commit real secrets.
APP_ENV=production
APP_DEBUG=false
APP_NAME="School Management Demo"
APP_URL=https://your-assigned-service.onrender.com
APP_KEY=
DEPLOYMENT_PROFILE=demo
DEMO_MODE=true
DB_CONNECTION=pgsql
DB_SSLMODE=require
# Pooled runtime endpoint; direct migration endpoint. Both must use the SAME Neon database.
DATABASE_URL=
MIGRATION_DATABASE_URL=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=array
LOG_CHANNEL=stderr
BULK_UPLOADS_ENABLED=false
EXTERNAL_MESSAGES_ENABLED=false
LIVE_PAYMENTS_ENABLED=false
# Enable only to provision a new demo owner, then disable after verifying access.
DEMO_BOOTSTRAP_ENABLED=false
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD_HASH=
DEMO_SCHOOL_NAME="Northstar Demonstration School"
DEMO_SCHOOL_SLUG=northstar-demo
DEMO_SEED=false
